[global_config]
  suppress_multiple_term_dialog = True
[keybindings]
  broadcast_off = <Alt>n
  broadcast_all = <Alt>b
[profiles]
  [[default]]
    background_darkness = 0.9
    background_type = transparent
    cursor_shape = ibeam
    font = JetBrainsMonoNL Nerd Font 10
    show_titlebar = False
    use_system_font = False
    cell_height = 2
    copy_on_selection = True
    title_transmit_bg_color = "#613583"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
